# Everything the build writes
# (in any directory: a run started from the wrong directory makes one there)
out/
# build/build.mk's Wine prefix, generated rules and header dependencies
/.wine/
/.build/
# the project files put every output in a built/ directory (the engine's,
# to come), or, AvP2's own, in Release/ and final/ beside the source and
# <project>___Win32_Final/ for the objects; and the prebuilt libraries
# build/build.mk copies where the project files name them
src/**/[Bb]uilt/
src/AVP2/*/[Rr]elease/
src/AVP2/*/[Ff]inal/
src/AVP2/*/*___Win32_*/
src/AVP2/*/PrimalHunt/
src/AVP2/AVP2Serv/server.lib
src/LT2/lithshared/libs/

__pycache__/
*.log
!src/**/*.log
# agents' worktrees (tools/agentwt.sh)
/.worktrees/
src/engine/*/[Rr]elease/
src/engine/*/AvP2Release/
src/lithshared/**/[Rr]elease/
