#
# ---- k2: the engine symbols nolfsrc's aliases never named ------------------
#
# Each one is bound to the definition of ours the retail call or vtable slot
# reaches. Addresses are Primal Hunt's server.dll, then AvP2 1.0.9.6's.
#
# The struct banks' three slots (bankbase.h's CBankBase). /O1 keeps every
# POD bank's AllocVoid and FreeVoid as the same folded forwarders and Term
# differs only in the record size it hands sb_Init, so each is bound to
# objbank.cpp's CObjectBank<CBankElemNN> of its own record size: the file
# records 0x14 (Term 0x10038a74 / 0x10035bb8), the hash elements 0x18
# (0x10011d60 / 0x10011503), the link nodes 0x0c (0x10044ab6 / 0x1003fa5a),
# the thread messages 0x20 (0x1001b260), the transfer files 0x1c
# (0x10012d75 / 0x100123a7).
/ALTERNATENAME:?AllocVoid@CFileBank@@UAEPAXXZ=?AllocVoid@?$CObjectBank@VCBankElem14@@@@UAEPAXXZ
/ALTERNATENAME:?FreeVoid@CFileBank@@UAEXPAX@Z=?FreeVoid@?$CObjectBank@VCBankElem14@@@@UAEXPAX@Z
/ALTERNATENAME:?Term@CFileBank@@UAEXXZ=?Term@?$CObjectBank@VCBankElem14@@@@UAEXXZ
/ALTERNATENAME:?AllocVoid@CHashElemBank@@UAEPAXXZ=?AllocVoid@?$CObjectBank@VCBankElem18@@@@UAEPAXXZ
/ALTERNATENAME:?FreeVoid@CHashElemBank@@UAEXPAX@Z=?FreeVoid@?$CObjectBank@VCBankElem18@@@@UAEXPAX@Z
