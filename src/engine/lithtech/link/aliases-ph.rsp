#
# ---- k2: the engine symbols nolfsrc's aliases never named ------------------
#
# Each one is bound to the definition of ours the retail call or vtable slot
# reaches: the function is placed by the scorer at the shipped target of the
# referencing function's call (or of the table's slot), and the bodies are
# the same object's. Addresses are Primal Hunt's lithtech.exe, then AvP2
# 1.0.9.6's.
#
# The struct banks' three slots (bankbase.h's CBankBase): every POD bank's
# AllocVoid and FreeVoid are the same bytes and Term differs only in the
# record size it hands sb_Init, so each is bound to objbank.cpp's
# CObjectBank<CBankElemNN> of its own record size (the shipped slots:
# CFileBank 0x004d4e84 {0x00404fb0, 0x00416070, 0x00418c80 Elem14},
# CHashElementBankQ532 0x004d5378 {0x00416060 = jmp 0x00404fb0, 0x00416070,
# 0x00437470 Elem18}, CXferFileBank 0x004d5444 {.., 0x0043b6c0 Elem1c};
# AvP2 0x004c6e6c / 0x004c7424 the same).
/ALTERNATENAME:?AllocVoid@CFileBank@@UAEPAXXZ=?AllocVoid@?$CObjectBank@VCBankElem14@@@@UAEPAXXZ
/ALTERNATENAME:?FreeVoid@CFileBank@@UAEXPAX@Z=?FreeVoid@?$CObjectBank@VCBankElem14@@@@UAEXPAX@Z
/ALTERNATENAME:?Term@CFileBank@@UAEXXZ=?Term@?$CObjectBank@VCBankElem14@@@@UAEXXZ
/ALTERNATENAME:?AllocVoid@CHashElementBankQ532@@UAEPAXXZ=?AllocVoid@?$CObjectBank@VCBankElem18@@@@UAEPAXXZ
/ALTERNATENAME:?FreeVoid@CHashElementBankQ532@@UAEXPAX@Z=?FreeVoid@?$CObjectBank@VCBankElem18@@@@UAEXPAX@Z
/ALTERNATENAME:?Term@CHashElementBankQ532@@UAEXXZ=?Term@?$CObjectBank@VCBankElem18@@@@UAEXXZ
/ALTERNATENAME:?AllocVoid@CXferFileBank@@UAEPAXXZ=?AllocVoid@?$CObjectBank@VCBankElem1c@@@@UAEPAXXZ
/ALTERNATENAME:?FreeVoid@CXferFileBank@@UAEXPAX@Z=?FreeVoid@?$CObjectBank@VCBankElem1c@@@@UAEXPAX@Z
/ALTERNATENAME:?Term@CXferFileBank@@UAEXXZ=?Term@?$CObjectBank@VCBankElem1c@@@@UAEXXZ
/ALTERNATENAME:?AllocVoid@CXferFileBankQ464@@UAEPAXXZ=?AllocVoid@?$CObjectBank@VCBankElem1c@@@@UAEPAXXZ
/ALTERNATENAME:?FreeVoid@CXferFileBankQ464@@UAEXPAX@Z=?FreeVoid@?$CObjectBank@VCBankElem1c@@@@UAEXPAX@Z
/ALTERNATENAME:?Term@CXferFileBankQ464@@UAEXXZ=?Term@?$CObjectBank@VCBankElem1c@@@@UAEXXZ
# CNetBank (vtable 0x004d5d2c / 0x004c7d14): slot 1 constructs the packet --
# 0x0046b200 is `jmp 0x0046b5c0` and AvP2's slot is 0x00465eb0 itself,
# startload.cpp's CNetBankQ11::Allocate in both; slot 3 is the 0x70 Term
# (0x0046b720 / 0x004662f0). Primal Hunt's SendPacket calls the same
# Allocate out of line (0x00468fd0 -> 0x0046b5c0), which netmgr.cpp only
# declares for that build.
/ALTERNATENAME:?AllocVoid@CNetBank@@UAEPAXXZ=?Allocate@CNetBankQ11@@QAEPAVCNetSentPacketQ11@@XZ
