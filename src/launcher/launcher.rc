// launcher.rc -- the launchers' resources, AVP2.exe's and PrimalHunt.exe's
// (PRIMAL_HUNT): read out of the retail images by tools/rsrc2rc.py. The two
// have the same dialogs and ids; Primal Hunt's strings differ where marked,
// and its art throughout. The art itself (res\) is not in the tree: the
// build reads it out of the retail image it builds against, into the
// object directory, where this script is compiled.
// Microsoft Visual C++ generated resource script.
//

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

